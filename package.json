{
  "name": "@masatomakino/threejs-drag-watcher",
  "version": "0.13.3",
  "description": "Mouse drag watcher for three.js",
  "keywords": [
    "threejs"
  ],
  "homepage": "https://github.com/MasatoMakino/threejs-drag-watcher#readme",
  "bugs": {
    "url": "https://github.com/MasatoMakino/threejs-drag-watcher/issues"
  },
  "license": "MIT",
  "author": "MasatoMakino <unagiinu.g@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://MasatoMakino@github.com/MasatoMakino/threejs-drag-watcher.git"
  },
  "directories": {
    "lib": "esm",
    "doc": "docs"
  },
  "files": [
    "esm"
  ],
  "type": "module",
  "types": "./esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "default": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      }
    }
  },
  "scripts": {
    "test": "vp test --run",
    "coverage": "vp test --run --coverage",
    "test:watch": "vp test",
    "lint": "vp check",
    "pre-commit": "vp fmt --no-error-on-unmatched-pattern",
    "pre-push": "vp check && pnpm test",
    "start:dev": "pnpm run server & pnpm run watch:tsc",
    "build": "pnpm run buildTS && pnpm run demo",
    "demo": "demo-showcase build --distDir ./docs/demo --body '<canvas id=\"webgl-canvas\" width=\"1280\" height=\"640\"></canvas>'",
    "buildTS": "tsc",
    "server": "demo-showcase dev --host 0.0.0.0 --port 3456 --body '<canvas id=\"webgl-canvas\" width=\"1280\" height=\"640\"></canvas>'",
    "watch:tsc": "tsc -W --incremental"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "@masatomakino/demo-showcase": "^0.1.3",
    "@masatomakino/fake-mouse-event": "^0.3.0",
    "@types/three": "^0.187.0",
    "@types/webxr": "^0.5.24",
    "@vitest/browser-webdriverio": "^5.0.0",
    "@vitest/coverage-istanbul": "catalog:",
    "three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "webdriverio": "^10.2.0"
  },
  "peerDependencies": {
    "@masatomakino/raf-ticker": "0.5.3 - 0.6.x",
    "three": ">=0.126.0 <1.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
