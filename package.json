{
  "name": "@masatomakino/threejs-drag-watcher",
  "version": "0.13.2",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "exports": {
    ".": {
      "import": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      },
      "default": {
        "types": "./esm/index.d.ts",
        "default": "./esm/index.js"
      }
    }
  },
  "types": "./esm/index.d.ts",
  "files": [
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://MasatoMakino@github.com/MasatoMakino/threejs-drag-watcher.git"
  },
  "author": "MasatoMakino <unagiinu.g@gmail.com>",
  "license": "MIT",
  "keywords": [
    "threejs"
  ],
  "peerDependencies": {
    "@masatomakino/raf-ticker": "0.5.3 - 0.6.x",
    "three": ">=0.126.0 <1.0.0"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.4",
    "@masatomakino/fake-mouse-event": "^0.3.0",
    "@masatomakino/gulptask-demo-page": "^0.10.0",
    "@types/three": "^0.187.0",
    "@types/webxr": "^0.5.24",
    "@vitest/browser-webdriverio": "^5.0.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "babel-loader": "10.0.0",
    "browser-sync": "^3.0.2",
    "source-map-loader": "5.0.0",
    "three": "^0.187.0",
    "ts-loader": "9.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.1.3",
    "vitest": "5.1.0",
    "webdriverio": "^10.2.0"
  },
  "scripts": {
    "test": "vitest --run",
    "coverage": "vitest --run --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "pre-commit": "biome format --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "pre-push": "biome ci . && pnpm test",
    "start:dev": "pnpm run server & pnpm run watch:tsc & pnpm run watch:demo",
    "build": "pnpm run buildTS && pnpm run demo && pnpm run typedocs",
    "demo": "gulptask-demo-page --body '<canvas id=\"webgl-canvas\" width=\"1280\" height=\"640\"></canvas>'  --compileModule es2020",
    "buildTS": "tsc",
    "typedocs": "typedoc --out ./docs/api src/index.ts",
    "server": "browser-sync ./docs/demo -w --port 3000 --no-open --no-ui",
    "watch:demo": "pnpm run demo -W",
    "watch:tsc": "tsc -W --incremental"
  },
  "description": "Mouse drag watcher for three.js",
  "bugs": {
    "url": "https://github.com/MasatoMakino/threejs-drag-watcher/issues"
  },
  "homepage": "https://github.com/MasatoMakino/threejs-drag-watcher#readme",
  "directories": {
    "doc": "docs",
    "lib": "esm"
  }
}
